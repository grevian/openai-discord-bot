#!/bin/bash
set -euxo pipefail

REGION="${region}"
PARAM_PREFIX="/${service}/${environment}"
IMAGES_BUCKET="${images_bucket}"
CONVERSATIONS_TBL="${conversations_tbl}"
FLAGS_TBL="${flags_tbl}"
OTELCOL_VERSION="${otelcol_version}"
OTELCOL_SHA256="${otelcol_sha256}"

ARTIFACTS_BUCKET="${artifacts_bucket}"

# 1 GiB swapfile before dnf (a t4g.nano OOM-killed `dnf update -y`). Best
# effort: failing must not stop this script. Prio 10: behind the AMI's zram.
if { dd if=/dev/zero of=/swapfile bs=1M count=1024 conv=fsync && chmod 600 /swapfile \
     && mkswap /swapfile && swapon -p 10 /swapfile; }; then
  echo '/swapfile none swap sw,pri=10 0 0' >> /etc/fstab
else
  echo "WARNING: swapfile setup failed; continuing without it" >&2
  swapoff /swapfile || true; rm -f /swapfile
fi

dnf update -y
dnf install -y tar gzip

# fetch-artifact NAME VERSION FILE [EXPECTED_SHA256]
# Downloads artifacts/NAME/VERSION/FILE from the private artifacts bucket
# (terraform/artifacts.tf) into a fresh directory under /var/tmp, checks it
# against FILE.sha256 stored next to it and, when given, against
# EXPECTED_SHA256 too (a hash pinned in the repo, so a replaced object in the
# bucket can't pass). Prints the verified file's path on stdout; on any
# failure prints why on stderr, deletes the download and exits non-zero.
# Installed as a script, not a shell function, so start scripts can call it
# later (e.g. on every restart), not only this boot script.
cat > /usr/local/bin/fetch-artifact <<EOF
#!/bin/bash
set -euo pipefail
REGION="$REGION"
ARTIFACTS_BUCKET="$ARTIFACTS_BUCKET"
EOF
cat >> /usr/local/bin/fetch-artifact <<'FETCH_EOF'
if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: fetch-artifact NAME VERSION FILE [EXPECTED_SHA256]" >&2
  exit 2
fi
NAME="$1" VERSION="$2" FILE="$3" PINNED="$${4:-}"
for part in "$NAME" "$VERSION" "$FILE"; do
  # One path segment each: no slashes, no "..", no empty parts.
  if ! [[ "$part" =~ ^[A-Za-z0-9._+-]+$ ]] || [[ "$part" == *..* ]]; then
    echo "fetch-artifact: invalid name, version or file: '$part'" >&2
    exit 2
  fi
done
if [ -n "$PINNED" ] && ! [[ "$PINNED" =~ ^[0-9a-f]{64}$ ]]; then
  echo "fetch-artifact: EXPECTED_SHA256 is not a sha256 hex digest" >&2
  exit 2
fi
KEY="artifacts/$NAME/$VERSION/$FILE"
DIR=$(mktemp -d /var/tmp/artifact.XXXXXX)
fail() { echo "fetch-artifact: $KEY: $*" >&2; rm -rf "$DIR"; exit 1; }
aws s3 cp --only-show-errors --region "$REGION" "s3://$ARTIFACTS_BUCKET/$KEY" "$DIR/$FILE" >&2 \
  || fail "download failed"
aws s3 cp --only-show-errors --region "$REGION" "s3://$ARTIFACTS_BUCKET/$KEY.sha256" "$DIR/$FILE.sha256" >&2 \
  || fail "checksum download failed"
WANT=$(awk 'NR == 1 { print $1 }' "$DIR/$FILE.sha256")
[[ "$WANT" =~ ^[0-9a-f]{64}$ ]] || fail "$FILE.sha256 holds no sha256 digest"
GOT=$(sha256sum "$DIR/$FILE" | awk '{ print $1 }')
[ "$GOT" = "$WANT" ] || fail "sha256 $GOT does not match $FILE.sha256 ($WANT)"
if [ -n "$PINNED" ] && [ "$GOT" != "$PINNED" ]; then
  fail "sha256 $GOT does not match the pinned $PINNED"
fi
rm -f "$DIR/$FILE.sha256"
echo "$DIR/$FILE"
FETCH_EOF
chmod 0755 /usr/local/bin/fetch-artifact

mkdir -p /etc/otel
cat > /etc/otel/config.yaml <<'OTEL_CONFIG_EOF'
${otel_config}
OTEL_CONFIG_EOF

# Collector: the minimal ocb build from otelcol/ (published by the Collector
# workflow), pinned by version and sha256 in terraform/variables.tf. Only an
# arm64 build is published: the AMI is arm64. It runs as its own system user;
# the unit adds the systemd-journal group so its journald receiver (which
# runs journalctl) can read the journal.
getent passwd otelcol > /dev/null || useradd --system --user-group --no-create-home --shell /sbin/nologin otelcol
# The binary is installed by otelcol-install.sh, which the unit runs before
# every start (ExecStartPre=+), not by this script: a failed fetch (S3 or the
# network not ready yet) is then retried with every restart, logged to the
# collector's journal, and never stops the bot from being set up.
cat > /usr/local/bin/otelcol-install.sh <<EOF
#!/bin/bash
set -euo pipefail
VERSION="$OTELCOL_VERSION"
SHA256="$OTELCOL_SHA256"
EOF
cat >> /usr/local/bin/otelcol-install.sh <<'INSTALL_EOF'
BIN=/usr/local/bin/otelcol-danbot
if [ -x "$BIN" ] && [ "$(sha256sum "$BIN" | awk '{ print $1 }')" = "$SHA256" ]; then
  exit 0
fi
echo "installing otelcol-danbot $VERSION"
if ! TMP=$(fetch-artifact otelcol-danbot "$VERSION" otelcol-danbot-linux-arm64 "$SHA256"); then
  echo "ERROR: could not fetch otelcol-danbot $VERSION; no telemetry until a restart succeeds" >&2
  exit 1
fi
install -m 0755 "$TMP" "$BIN.new"
mv -f "$BIN.new" "$BIN"
rm -rf "$(dirname "$TMP")"
echo "installed otelcol-danbot $VERSION"
INSTALL_EOF
chmod 0755 /usr/local/bin/otelcol-install.sh

# The bot is the native binary from the artifacts bucket (deploy.yml):
# /opt/danbot/releases/<git sha>/{danbot,prompts/}, /opt/danbot/current -> one.
id danbot >/dev/null 2>&1 || useradd --system --home-dir /opt/danbot --no-create-home --shell /sbin/nologin danbot
install -d -m 0755 -o root -g root /opt/danbot /opt/danbot/releases

# danbot-prepare.sh (root, ExecStartPre=+) runs before every start, so
# `systemctl restart bot` is the deploy: it installs the release named by the
# image_tag SSM parameter and writes the secrets to /run/danbot/bot.env (tmpfs,
# root 0600, the unit's EnvironmentFile). No `set -x`: it would log them.
cat > /usr/local/bin/danbot-prepare.sh <<EOF
#!/bin/bash
set -euo pipefail

REGION="$REGION"
PARAM_PREFIX="$PARAM_PREFIX"
EOF
cat >> /usr/local/bin/danbot-prepare.sh <<'PREPARE_EOF'
# Runs under the unit's UMask=0077: without this the release unpacks as 0700.
umask 022
ARTIFACT_FILE=danbot-linux-arm64.tar.gz
KEEP_RELEASES=3

# get NAME [aws args]: the SSM parameter's value
get() {
  local name="$1"
  shift
  aws ssm get-parameter --name "$PARAM_PREFIX/$name" "$@" --query 'Parameter.Value' --output text --region "$REGION"
}

# --- 1. install the release -------------------------------------------------
SHA=$(get image_tag)
if ! [[ "$SHA" =~ ^[0-9a-f]{40}$ ]]; then
  echo "danbot-prepare: image_tag '$SHA' is not a git sha; deploy.yml sets it on every deploy" >&2
  exit 1
fi
REL="/opt/danbot/releases/$SHA"
if [ ! -x "$REL/danbot" ]; then
  FILE=$(/usr/local/bin/fetch-artifact danbot "$SHA" "$ARTIFACT_FILE")
  STAGE=$(mktemp -d /opt/danbot/releases/.stage.XXXXXX)
  trap 'rm -rf "$STAGE" "$(dirname "$FILE")"' EXIT
  tar -xzf "$FILE" -C "$STAGE" --no-same-owner --no-same-permissions
  if [ ! -x "$STAGE/danbot" ] || [ ! -f "$STAGE/prompts/danbo.json" ]; then
    echo "danbot-prepare: $ARTIFACT_FILE for $SHA lacks danbot or prompts/danbo.json" >&2
    exit 1
  fi
  chown -R root:root "$STAGE"
  rm -rf "$REL"
  mv -T "$STAGE" "$REL"
fi
# Root-owned, readable and runnable by the bot's user, writable by nobody
# else. Done on every start so a release installed with other modes is fixed.
chmod -R u=rwX,go=rX "$REL"
ln -sfn "$REL" /opt/danbot/current.new
mv -T /opt/danbot/current.new /opt/danbot/current

# Keep the newest releases (rollback targets) and delete the rest. Never the
# current one, whatever its age.
ls -1dt /opt/danbot/releases/*/ 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | while read -r old; do
  [ "$(basename "$old")" = "$SHA" ] || rm -rf "$old"
done

# --- 2. secrets and optional settings -> the unit's EnvironmentFile ---------
DISCORD_TOKEN=$(get discord_token --with-decryption)
OPENAI_TOKEN=$(get openai_token --with-decryption)
# Optional: link summaries stay off when the key can't be read or is the placeholder.
KAGI_API_KEY=$(get kagi_api_key --with-decryption) || KAGI_API_KEY=""
if [ "$KAGI_API_KEY" = "populated-out-of-band" ]; then KAGI_API_KEY=""; fi
# Optional: the owner-only flag command stays off when the ID can't be read or is the placeholder.
OWNER_USER_ID=$(get owner_user_id) || OWNER_USER_ID=""
if [ "$OWNER_USER_ID" = "populated-out-of-band" ]; then OWNER_USER_ID=""; fi

# An EnvironmentFile line ends at a newline and gives quotes, backslashes and
# a leading # a meaning, so only plain token characters are written. A required
# secret with other characters stops the start; an optional value is dropped
# with a warning (that feature stays off) instead of keeping the bot down.
for v in DISCORD_TOKEN OPENAI_TOKEN; do
  if ! [[ "$${!v}" =~ ^[A-Za-z0-9._~+/=-]*$ ]]; then
    echo "danbot-prepare: $v holds characters outside [A-Za-z0-9._~+/=-]; not writing it" >&2
    exit 1
  fi
done
for v in KAGI_API_KEY OWNER_USER_ID; do
  if ! [[ "$${!v}" =~ ^[A-Za-z0-9._~+/=-]*$ ]]; then
    echo "danbot-prepare: WARNING: optional $v holds characters outside [A-Za-z0-9._~+/=-]; leaving it unset" >&2
    printf -v "$v" '%s' ""
  fi
done

install -d -m 0700 -o root -g root /run/danbot
(umask 077; printf 'BOT_DISCORD_TOKEN=%s\nBOT_OPENAI_AUTH_TOKEN=%s\nBOT_KAGI_API_KEY=%s\nBOT_OWNER_USER_ID=%s\n' \
  "$DISCORD_TOKEN" "$OPENAI_TOKEN" "$KAGI_API_KEY" "$OWNER_USER_ID" > /run/danbot/bot.env.tmp)
mv -f /run/danbot/bot.env.tmp /run/danbot/bot.env
echo "danbot-prepare: release $SHA is current"
PREPARE_EOF
chmod 0755 /usr/local/bin/danbot-prepare.sh

# Runs as root before each collector start (ExecStartPre=+): writes the
# Honeycomb key to a root-only env file on tmpfs, which systemd passes to the
# collector (EnvironmentFile), so the collector itself needs no AWS access.
cat > /usr/local/bin/otelcol-env.sh <<EOF
#!/bin/bash
set -euo pipefail

REGION="$REGION"
PARAM_PREFIX="$PARAM_PREFIX"

HONEYCOMB_API_KEY=\$(aws ssm get-parameter --name "\$PARAM_PREFIX/honeycomb_api_key" --with-decryption --query 'Parameter.Value' --output text --region "\$REGION")
ENV_FILE=/run/otelcol/env
(umask 077; printf 'HONEYCOMB_API_KEY=%s\\n' "\$HONEYCOMB_API_KEY" > "\$ENV_FILE.tmp")
mv -f "\$ENV_FILE.tmp" "\$ENV_FILE"
EOF
chmod +x /usr/local/bin/otelcol-env.sh

cat > /etc/systemd/system/otel-collector.service <<'UNIT_EOF'
[Unit]
Description=OpenTelemetry Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=otelcol
Group=otelcol
SupplementaryGroups=systemd-journal
# /run/otelcol, recreated on every start; the env file in it is root-only
RuntimeDirectory=otelcol
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/local/bin/otelcol-install.sh
ExecStartPre=+/usr/local/bin/otelcol-env.sh
# "-": the file does not exist yet when ExecStartPre itself is spawned
EnvironmentFile=-/run/otelcol/env
ExecStart=/usr/local/bin/otelcol-danbot --config=/etc/otel/config.yaml
# Steady state is ~40 MB RSS. Three layers above that: GOMEMLIMIT makes the
# Go GC work harder from 80 MiB, memory_limiter (adot config) refuses new
# data from 75 MiB (soft) / 100 MiB (hard), and MemoryMax is the backstop:
# the kernel kills the collector, not the bot, and systemd restarts it.
Environment=GOMEMLIMIT=80MiB
MemoryHigh=96M
MemoryMax=128M
MemorySwapMax=0
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT_EOF

# The sandbox leaves the bot read-write only to a private /tmp (state is in
# DynamoDB and S3) and allows IP, unix and netlink sockets. A blocked syscall
# returns EPERM. TimeoutStopSec=45 matches the shutdown budget in shutdown.go.
cat > /etc/systemd/system/bot.service <<'UNIT_EOF'
[Unit]
Description=OpenAI Discord Bot (danbot)
After=otel-collector.service network-online.target
Wants=otel-collector.service network-online.target

[Service]
Type=simple
User=danbot
Group=danbot
# "-": systemd enters this before ExecStartPre= creates it (first start).
WorkingDirectory=-/opt/danbot/current
ExecStartPre=+/usr/local/bin/danbot-prepare.sh
ExecStart=/opt/danbot/current/danbot
EnvironmentFile=-/run/danbot/bot.env
Environment=BOT_JSON_LOGS=true
Environment=BOT_TRACING=true
Environment=BOT_OTLP_LOGS=true
Environment=BOT_OPENAIDISCORDBOTIMAGES_NAME=${images_bucket}
Environment=AI_DISCORD_BOT_CONVERSATIONS_NAME=${conversations_tbl}
Environment=BOT_FLAGS_TABLE=${flags_tbl}
Environment=BOT_FEEDBACK_TABLE=${feedback_tbl}
Environment=OTEL_SERVICE_NAME=danbot
Environment=OTEL_EXPORTER_OTLP_INSECURE=true
# Go soft memory limit (a Dockerfile ENV doesn't reach the native process).
Environment=GOMEMLIMIT=64MiB
# Cgroup limits sized for a 512 MiB t4g.nano (with the collector's 128M and
# ~90 MiB for the OS). Bot idle ~42 MiB; its ExecStartPre aws cli ~57 MiB.
# No swap for the services (MemorySwapMax=0).
MemoryHigh=144M
MemoryMax=176M
MemorySwapMax=0
TimeoutStartSec=300
TimeoutStopSec=45
Restart=always
RestartSec=10

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
UNIT_EOF

systemctl daemon-reload
systemctl enable otel-collector.service bot.service
# --no-block: a collector that can't start (SSM, S3) must not fail this
# script (set -e) before the bot is started. The bot only Wants the collector.
systemctl start --no-block otel-collector.service
systemctl start --no-block bot.service
