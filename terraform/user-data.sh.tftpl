#!/bin/bash
set -euxo pipefail

REGION="${region}"
PARAM_PREFIX="/${service}/${environment}"
IMAGE_REPO="${image_repo}"
IMAGES_BUCKET="${images_bucket}"
CONVERSATIONS_TBL="${conversations_tbl}"
FLAGS_TBL="${flags_tbl}"
OTELCOL_VERSION="${otelcol_version}"
OTELCOL_SHA256="${otelcol_sha256}"

ARTIFACTS_BUCKET="${artifacts_bucket}"

ARTIFACTS_BUCKET="${artifacts_bucket}"

dnf update -y
dnf install -y docker tar gzip
systemctl enable --now docker

# fetch-artifact NAME VERSION FILE [EXPECTED_SHA256]
# Downloads artifacts/NAME/VERSION/FILE from the private artifacts bucket
# (terraform/artifacts.tf) into a fresh directory under /var/tmp, checks it
# against FILE.sha256 stored next to it and, when given, against
# EXPECTED_SHA256 too (a hash pinned in the repo, so a replaced object in the
# bucket can't pass). Prints the verified file's path on stdout; on any
# failure prints why on stderr, deletes the download and exits non-zero.
# Installed as a script, not a shell function, so start scripts can call it
# later (e.g. on every restart), not only this boot script.
cat > /usr/local/bin/fetch-artifact <<EOF
#!/bin/bash
set -euo pipefail
REGION="$REGION"
ARTIFACTS_BUCKET="$ARTIFACTS_BUCKET"
EOF
cat >> /usr/local/bin/fetch-artifact <<'FETCH_EOF'
if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: fetch-artifact NAME VERSION FILE [EXPECTED_SHA256]" >&2
  exit 2
fi
NAME="$1" VERSION="$2" FILE="$3" PINNED="$${4:-}"
for part in "$NAME" "$VERSION" "$FILE"; do
  # One path segment each: no slashes, no "..", no empty parts.
  if ! [[ "$part" =~ ^[A-Za-z0-9._+-]+$ ]] || [[ "$part" == *..* ]]; then
    echo "fetch-artifact: invalid name, version or file: '$part'" >&2
    exit 2
  fi
done
if [ -n "$PINNED" ] && ! [[ "$PINNED" =~ ^[0-9a-f]{64}$ ]]; then
  echo "fetch-artifact: EXPECTED_SHA256 is not a sha256 hex digest" >&2
  exit 2
fi
KEY="artifacts/$NAME/$VERSION/$FILE"
DIR=$(mktemp -d /var/tmp/artifact.XXXXXX)
fail() { echo "fetch-artifact: $KEY: $*" >&2; rm -rf "$DIR"; exit 1; }
aws s3 cp --only-show-errors --region "$REGION" "s3://$ARTIFACTS_BUCKET/$KEY" "$DIR/$FILE" >&2 \
  || fail "download failed"
aws s3 cp --only-show-errors --region "$REGION" "s3://$ARTIFACTS_BUCKET/$KEY.sha256" "$DIR/$FILE.sha256" >&2 \
  || fail "checksum download failed"
WANT=$(awk 'NR == 1 { print $1 }' "$DIR/$FILE.sha256")
[[ "$WANT" =~ ^[0-9a-f]{64}$ ]] || fail "$FILE.sha256 holds no sha256 digest"
GOT=$(sha256sum "$DIR/$FILE" | awk '{ print $1 }')
[ "$GOT" = "$WANT" ] || fail "sha256 $GOT does not match $FILE.sha256 ($WANT)"
if [ -n "$PINNED" ] && [ "$GOT" != "$PINNED" ]; then
  fail "sha256 $GOT does not match the pinned $PINNED"
fi
rm -f "$DIR/$FILE.sha256"
echo "$DIR/$FILE"
FETCH_EOF
chmod 0755 /usr/local/bin/fetch-artifact

mkdir -p /etc/otel
cat > /etc/otel/config.yaml <<'OTEL_CONFIG_EOF'
${otel_config}
OTEL_CONFIG_EOF

# Collector: the minimal ocb build from otelcol/ (published by the Collector
# workflow), pinned by version and sha256 in terraform/variables.tf. Only an
# arm64 build is published: the AMI is arm64. It runs as its own system user;
# the unit adds the systemd-journal group so its journald receiver (which
# runs journalctl) can read the journal.
getent passwd otelcol > /dev/null || useradd --system --user-group --no-create-home --shell /sbin/nologin otelcol
# The binary is installed by otelcol-install.sh, which the unit runs before
# every start (ExecStartPre=+), not by this script: a failed fetch (S3 or the
# network not ready yet) is then retried with every restart, logged to the
# collector's journal, and never stops the bot from being set up.
cat > /usr/local/bin/otelcol-install.sh <<EOF
#!/bin/bash
set -euo pipefail
VERSION="$OTELCOL_VERSION"
SHA256="$OTELCOL_SHA256"
EOF
cat >> /usr/local/bin/otelcol-install.sh <<'INSTALL_EOF'
BIN=/usr/local/bin/otelcol-danbot
if [ -x "$BIN" ] && [ "$(sha256sum "$BIN" | awk '{ print $1 }')" = "$SHA256" ]; then
  exit 0
fi
echo "installing otelcol-danbot $VERSION"
if ! TMP=$(fetch-artifact otelcol-danbot "$VERSION" otelcol-danbot-linux-arm64 "$SHA256"); then
  echo "ERROR: could not fetch otelcol-danbot $VERSION; no telemetry until a restart succeeds" >&2
  exit 1
fi
install -m 0755 "$TMP" "$BIN.new"
mv -f "$BIN.new" "$BIN"
rm -rf "$(dirname "$TMP")"
echo "installed otelcol-danbot $VERSION"
INSTALL_EOF
chmod 0755 /usr/local/bin/otelcol-install.sh

cat > /usr/local/bin/start-bot.sh <<EOF
#!/bin/bash
set -euo pipefail

REGION="$REGION"
PARAM_PREFIX="$PARAM_PREFIX"
IMAGE_REPO="$IMAGE_REPO"
IMAGES_BUCKET="$IMAGES_BUCKET"
CONVERSATIONS_TBL="$CONVERSATIONS_TBL"
FLAGS_TBL="$FLAGS_TBL"

IMAGE_TAG=\$(aws ssm get-parameter --name "\$PARAM_PREFIX/image_tag" --query 'Parameter.Value' --output text --region "\$REGION")
DISCORD_TOKEN=\$(aws ssm get-parameter --name "\$PARAM_PREFIX/discord_token" --with-decryption --query 'Parameter.Value' --output text --region "\$REGION")
OPENAI_TOKEN=\$(aws ssm get-parameter --name "\$PARAM_PREFIX/openai_token" --with-decryption --query 'Parameter.Value' --output text --region "\$REGION")
# Optional: link summaries stay off when the key can't be read or is the placeholder.
KAGI_API_KEY=\$(aws ssm get-parameter --name "\$PARAM_PREFIX/kagi_api_key" --with-decryption --query 'Parameter.Value' --output text --region "\$REGION") || KAGI_API_KEY=""
if [ "\$KAGI_API_KEY" = "populated-out-of-band" ]; then KAGI_API_KEY=""; fi
# Optional: the owner-only flag command stays off when the ID can't be read or is the placeholder.
OWNER_USER_ID=\$(aws ssm get-parameter --name "\$PARAM_PREFIX/owner_user_id" --query 'Parameter.Value' --output text --region "\$REGION") || OWNER_USER_ID=""
if [ "\$OWNER_USER_ID" = "populated-out-of-band" ]; then OWNER_USER_ID=""; fi

# Secrets go to docker through a root-only env file, not -e NAME=value, so
# they don't show in the docker client's command line (ps, /proc/*/cmdline).
# docker inspect still shows them, as it does for any container env. /run is
# tmpfs, so the file never reaches disk; it is rewritten on every start.
ENV_FILE=/run/danbot/bot.env
install -d -m 0700 /run/danbot
(umask 077; printf 'BOT_DISCORD_TOKEN=%s\nBOT_OPENAI_AUTH_TOKEN=%s\nBOT_KAGI_API_KEY=%s\n' \\
  "\$DISCORD_TOKEN" "\$OPENAI_TOKEN" "\$KAGI_API_KEY" > "\$ENV_FILE.tmp")
mv -f "\$ENV_FILE.tmp" "\$ENV_FILE"

IMAGE="\$IMAGE_REPO:\$IMAGE_TAG"
docker pull "\$IMAGE"
docker rm -f bot 2>/dev/null || true
exec docker run --rm --name bot --network host --stop-timeout 45 \\
  -e BOT_JSON_LOGS=true \\
  -e BOT_TRACING=true \\
  -e BOT_OTLP_LOGS=true \\
  -e BOT_OPENAIDISCORDBOTIMAGES_NAME="\$IMAGES_BUCKET" \\
  -e AI_DISCORD_BOT_CONVERSATIONS_NAME="\$CONVERSATIONS_TBL" \\
  -e BOT_FLAGS_TABLE="\$FLAGS_TBL" \\
  -e BOT_OWNER_USER_ID="\$OWNER_USER_ID" \\
  -e OTEL_SERVICE_NAME=danbot \\
  -e OTEL_EXPORTER_OTLP_INSECURE=true \\
  --env-file "\$ENV_FILE" \\
  "\$IMAGE"
EOF
chmod +x /usr/local/bin/start-bot.sh

# Runs as root before each collector start (ExecStartPre=+): writes the
# Honeycomb key to a root-only env file on tmpfs, which systemd passes to the
# collector (EnvironmentFile), so the collector itself needs no AWS access.
cat > /usr/local/bin/otelcol-env.sh <<EOF
#!/bin/bash
set -euo pipefail

REGION="$REGION"
PARAM_PREFIX="$PARAM_PREFIX"

HONEYCOMB_API_KEY=\$(aws ssm get-parameter --name "\$PARAM_PREFIX/honeycomb_api_key" --with-decryption --query 'Parameter.Value' --output text --region "\$REGION")
ENV_FILE=/run/otelcol/env
(umask 077; printf 'HONEYCOMB_API_KEY=%s\\n' "\$HONEYCOMB_API_KEY" > "\$ENV_FILE.tmp")
mv -f "\$ENV_FILE.tmp" "\$ENV_FILE"
EOF
chmod +x /usr/local/bin/otelcol-env.sh

cat > /etc/systemd/system/otel-collector.service <<'UNIT_EOF'
[Unit]
Description=OpenTelemetry Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=otelcol
Group=otelcol
SupplementaryGroups=systemd-journal
# /run/otelcol, recreated on every start; the env file in it is root-only
RuntimeDirectory=otelcol
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/local/bin/otelcol-install.sh
ExecStartPre=+/usr/local/bin/otelcol-env.sh
# "-": the file does not exist yet when ExecStartPre itself is spawned
EnvironmentFile=-/run/otelcol/env
ExecStart=/usr/local/bin/otelcol-danbot --config=/etc/otel/config.yaml
# Steady state is ~40 MB RSS. Three layers above that: GOMEMLIMIT makes the
# Go GC work harder from 80 MiB, memory_limiter (adot config) refuses new
# data from 75 MiB (soft) / 100 MiB (hard), and MemoryMax is the backstop:
# the kernel kills the collector, not the bot, and systemd restarts it.
Environment=GOMEMLIMIT=80MiB
MemoryHigh=150M
MemoryMax=200M
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT_EOF

cat > /etc/systemd/system/bot.service <<'UNIT_EOF'
[Unit]
Description=OpenAI Discord Bot
After=docker.service otel-collector.service network-online.target
Requires=docker.service
Wants=otel-collector.service network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/start-bot.sh
ExecStop=/usr/bin/docker stop -t 45 bot
TimeoutStopSec=60
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT_EOF

systemctl daemon-reload
systemctl enable otel-collector.service bot.service
# --no-block: a collector that can't start (SSM, S3) must not fail this
# script (set -e) before the bot is started. The bot only Wants the collector.
systemctl start --no-block otel-collector.service
systemctl start --no-block bot.service
